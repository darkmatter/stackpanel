{
  "name": "stackpanel",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "packages/ui/*",
      "packages/gen/*"
    ],
    "catalog": {
      "hono": "^4.12.18",
      "zod": "^4.4.3",
      "better-auth": "^1.4.5",
      "ai": "^5.0.49",
      "@ai-sdk/google": "^2.0.13",
      "dotenv": "^17.2.2",
      "alchemy": "2.0.0-beta.43",
      "@aws-sdk/credential-providers": "^3.0.0",
      "@cloudflare/containers": "^0.1.1",
      "@cloudflare/vite-plugin": "^1.13.12",
      "@cloudflare/workers-types": "^4.20250805.0",
      "@distilled.cloud/aws": "^0.21.5",
      "@distilled.cloud/cloudflare-bundler": "0.5.4",
      "@distilled.cloud/cloudflare": "^0.21.5",
      "@distilled.cloud/core": "^0.21.5",
      "@distilled.cloud/fly-io": "^0.21.5",
      "@distilled.cloud/neon": "^0.21.5",
      "@effect/language-service": "^0.85.1",
      "@effect/platform-node-shared": "4.0.0-beta.48",
      "@effect/platform-node": "4.0.0-beta.48",
      "@effect/platform-bun": "4.0.0-beta.48",
      "@effect/vitest": "4.0.0-beta.48",
      "@tanstack/react-query": "^5.100.9",
      "@tanstack/react-router": "^1.169.2",
      "@trpc/server": "^11.7.2",
      "@trpc/client": "^11.7.2",
      "@trpc/tanstack-react-query": "^11.7.2",
      "@prisma/client": "^7.0.1",
      "@polar-sh/better-auth": "^1.8.4",
      "effect": "4.0.0-beta.48",
      "react": "19.2.6",
      "react-dom": "19.2.6",
      "tailwindcss": "^4.1.16",
      "sst": "^3.17.25",
      "@pulumi/aws": "^7.15.0",
      "@aws-sdk/client-ec2": "^3.953.0",
      "@aws-sdk/client-ecr": "^3.953.0",
      "@aws-sdk/client-elastic-load-balancing-v2": "^3.953.0",
      "@aws-sdk/client-iam": "^3.953.0",
      "@aws-sdk/client-kms": "^3.953.0",
      "@aws-sdk/client-sts": "^3.953.0",
      "@aws-sdk/client-ssm": "^3.953.0"
    }
  },
  "scripts": {
    "check": "vp lint && vp fmt --write",
    "lint": "vp lint .",
    "ruler:apply": "bunx @intellectronica/ruler@latest apply --local-only",
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "test": "turbo test",
    "lessons:effects": "bun --filter @stackpanel/effect-lessons lesson",
    "db:studio": "turbo -F @stackpanel/db db:studio",
    "db:generate": "turbo -F @stackpanel/db db:generate",
    "db:migrate": "turbo -F @stackpanel/db db:migrate",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy"
  },
  "dependencies": {
    "@intellectronica/ruler": "^0.3.18",
    "effect": "^4.0.0-beta.64",
    "sst": "^4.13.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/client-ssm": "^3.1045.0",
    "@cloudflare/workers-types": "^4.20260508.1",
    "@effect/language-service": "^0.85.1",
    "@gen/config": "workspace:*",
    "@gen/env": "workspace:*",
    "@types/bun": "^1.3.13",
    "@types/node": "^22.13.11",
    "alchemy": "catalog:",
    "cloudflare": "^6.1.0",
    "rolldown": "1.0.0",
    "turbo": "^2.5.4",
    "typescript": "latest",
    "vite": "^8.0.7",
    "workerd": "1.20260508.1"
  },
  "packageManager": "bun@1.3.2",
  "overrides": {
    "effect": "4.0.0-beta.48",
    "@effect/platform-node": "4.0.0-beta.48",
    "@effect/platform-node-shared": "4.0.0-beta.48",
    "@effect/platform-bun": "4.0.0-beta.48"
  },
  "patchedDependencies": {
    "alchemy@2.0.0-beta.43": "patches/alchemy@2.0.0-beta.43.patch"
  }
}
