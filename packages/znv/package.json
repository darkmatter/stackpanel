{
	"name": "znv",
	"version": "0.5.0",
	"description": "Parse your environment with Zod schemas. Vendored from github.com/lostfictions/znv v0.5.0, patched for Zod 4 compatibility (upstream requires Zod 3).",
	"keywords": [
		"env",
		"process.env",
		"validation",
		"zod"
	],
	"license": "MIT",
	"type": "module",
	"main": "src/index.ts",
	"module": "src/index.ts",
	"exports": {
		".": {
			"import": "./src/index.ts",
			"require": "./src/index.ts"
		}
	},
	"scripts": {
		"build:lib": "run-s -l \"build:*\"",
		"build:clean": "rm -rf src/ src-cjs/",
		"build:mjs": "tsc --project tsconfig.build.tson",
		"build:cjs": "tsc --project tsconfig.cjs.build.tson",
		"build:copy": "cp package.cjs.tson src-cjs/package.tson",
		"test": "run-p -cl \"test:*\"",
		"test:ts": "tsc --noEmit",
		"test:eslint": "eslint --color src",
		"test:jest": "jest --colors",
		"test:prettier": "prettier -l \"src/**/*\"",
		"test:attw": "attw . --pack --profile node16",
		"prettier": "prettier \"src/**/*\" --write",
		"jest": "jest --colors --watch",
		"prepublishOnly": "run-s -l test build"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.2",
		"@types/jest": "^30.0.0",
		"@types/node": "^22.13.10",
		"eslint": "^10.3.0",
		"jest": "^30.4.1",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.5.3",
		"typescript": "^6.0.3"
	}
}
