    "deploy:staging": "bunx alchemy deploy --stage staging",
    "destroy": "bunx alchemy destroy",
    "dev": "vite --host",
    "dev:alchemy": "alchemy dev --host",
    "dev:portless": "portless stackpanel --app-port 5775  bun run dev",
    "e2e:install": "playwright install chromium",
    "e2e:test": "playwright test",
    "e2e:test:headed": "playwright test --headed",
    "e2e:test:ui": "playwright test --ui",
    "serve": "vite preview",
    "test": "vitest run --exclude 'src/test/integration/**'",
    "test:all": "vitest run --testTimeout=120000",
    "test:coverage": "vitest run --coverage --exclude 'src/test/integration/**'",
    "test:integration": "vitest run --include 'src/test/integration/**' --testTimeout=120000",
    "test:watch": "vitest --exclude 'src/test/integration/**'",
    "web:dev": "vite --host"
  },
